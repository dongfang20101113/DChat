[Unit]
Description=dchat × DeepSeek 机器人（api 模式，跑在这台服务器上）
Documentation=https://github.com/dongfang20101113/DChat
# dchat 服务在跑它才有意义；dchat 重启时它也会自己重连，所以只排顺序不强依赖
After=network-online.target dchat.service
Wants=network-online.target

[Service]
Type=simple
# 以 root 跑（用户要求：让机器人能装软件、改系统配置、重启服务）。
# ⚠️ 但**沙箱不拆**：文件系统仍然只有下面 ReadWritePaths 那几处可写，
#    /usr /boot /etc 其余部分一律只读，NoNewPrivileges 也留着。
#    真要放开更多路径，就往 ReadWritePaths 里加，别去动 ProtectSystem。
User=root
Group=root
WorkingDirectory=/srv/dchat-bot

# 配置里 brain.cwd = /srv/dchat-bot/work：它读写文件、跑命令都在那一个目录里
ExecStart=/opt/dchat-bot/dchat-dsh-bot --config /etc/dchat-bot/bot.conf
Restart=always
RestartSec=5

# 可写路径：工作目录、日志、机器人自己的配置目录。
# ⚠️ 只改 /etc/dchat-bot 的属主是不够的：ProtectSystem=full 会把 /etc 整个挂成只读，
#    必须在这里显式开一个可写路径，否则保存会报"写不了 bot.conf.tmp"。
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
# 前缀 - 表示"这个路径不存在也不报错"（ReadWritePaths 里写不存在的路径会让服务起不来）
ReadWritePaths=/srv/dchat-bot /var/log/dchat-bot /etc/dchat-bot /var/lib/dchat /opt/dchat

[Install]
WantedBy=multi-user.target
